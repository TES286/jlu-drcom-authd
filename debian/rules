#!/usr/bin/make -f
# SPDX-License-Identifier: AGPL-3.0-or-later

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- \
		-Dsystemdsystemunitdir=/lib/systemd/system \
		-Dtests=disabled

# dh_auto_install in compat 13 installs directly to debian/<package>/
# (not debian/tmp/), so no .install file is needed.  We just add the
# tmpfiles.d snippet after the main install.
execute_after_dh_auto_install:
	install -D -m 0644 debian/jlu-drcom-authd.tmpfiles \
		debian/jlu-drcom-authd/usr/lib/tmpfiles.d/jlu-drcom-authd.conf

override_dh_installsystemd:
	dh_installsystemd --name=jlu-drcom-authd
	dh_installsystemd --name=jlu-drcom-authd@
