#!/usr/bin/make -f
# SPDX-License-Identifier: AGPL-3.0-or-later

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- \
		-Dsystemdsystemunitdir=/lib/systemd/system \
		-Dtests=disabled

# Install the tmpfiles.d snippet alongside the meson-installed files.
override_dh_install:
	dh_install
	install -D -m 0644 debian/jlu-drcom-authd.tmpfiles \
		debian/jlu-drcom-authd/usr/lib/tmpfiles.d/jlu-drcom-authd.conf

override_dh_installsystemd:
	dh_installsystemd --name=jlu-drcom-authd
	dh_installsystemd --name=jlu-drcom-authd@
